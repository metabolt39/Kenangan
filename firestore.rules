rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function member() {
      return signedIn() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function admin() {
      return member() && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // Kod keluarga hanya boleh dibaca oleh peraturan ini, bukan oleh app.
    match /config/{doc} {
      allow read, write: if false;
    }

    match /members/{uid} {
      allow read: if member() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'joinedAt', 'code'])
        && request.resource.data.code == get(/databases/$(database)/documents/config/family).data.code;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo']);
    }

    // Nota peribadi: hanya pemilik
    match /data/users/{uid}/{rest=**} {
      allow read, write: if member() && request.auth.uid == uid;
    }

    match /posts/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.authorId == request.auth.uid;
      allow update: if member() && resource.data.authorId == request.auth.uid && request.resource.data.authorId == request.auth.uid;
      allow delete: if member() && (resource.data.authorId == request.auth.uid || admin());
    }

    match /likes/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.uid == request.auth.uid;
      allow delete: if member();
    }

    match /comments/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.authorId == request.auth.uid;
      allow delete: if member();
    }

    match /imgs/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.by == request.auth.uid;
      allow delete: if member();
    }
  }
}
